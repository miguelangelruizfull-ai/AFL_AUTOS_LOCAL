{
  "schemaVersion": "1.2.0",
  "updated": "2026-09-27",
  "driveRoot": "AFL_AUTOS_MULTIMEDIA",
  "inputTemplate": {
    "root": "01_ENTRADAS/{AFL-ID}",
    "folders": [
      {
        "name": "00_MATERIAL_DISPONIBLE_LOCAL",
        "purpose": "ingesta inicial"
      },
      {
        "name": "10_APROBADOS",
        "purpose": "material revisado"
      },
      {
        "name": "20_NUEVA_CAPTURA",
        "purpose": "material nuevo de campo"
      },
      {
        "name": "90_RECHAZADOS",
        "purpose": "material no útil"
      },
      {
        "name": "95_DUPLICADOS",
        "purpose": "copias exactas o redundantes"
      }
    ]
  },
  "outputTemplate": {
    "root": "02_SALIDAS/{AFL-ID}",
    "folders": [
      "00_CONTENIDO_DISPONIBLE",
      "10_MARKETPLACE",
      "20_IMAGENES_COMERCIALES",
      "30_POST",
      "40_FEED",
      "50_HISTORIAS",
      "60_PORTADAS",
      "70_REEL",
      "80_TIKTOK",
      "90_WHATSAPP_OCULTO",
      "95_PARA_ENVIAR"
    ],
    "controlDocument": {
      "name": "{AFL-ID} — CONTROL OPERATIVO",
      "location": "02_SALIDAS/{AFL-ID}",
      "purpose": "checkpoint, edición autorizada, respuestas rápidas y sincronización Drive ↔ JSON ↔ HOME"
    }
  },
  "rules": {
    "originalsImmutable": true,
    "autoDeleteRejected": false,
    "autoDeleteDuplicates": false,
    "pendingReviewNotForProduction": true,
    "autoPublish": false,
    "controlDocumentRequired": true,
    "authorizedEditSyncRequired": true
  },
  "staging": {
    "root": "01_ENTRADAS/00_PENDIENTE_ID",
    "purpose": "Material de vehículos que todavía no tienen AFL-ID confirmado",
    "rules": [
      "No mezclar unidades",
      "No crear AFL-ID definitivo sin evidencia suficiente",
      "Después de confirmar AFL-ID, consolidar material en 01_ENTRADAS/AFL-ID/00_MATERIAL_DISPONIBLE_LOCAL",
      "Si la carga está en curso, iniciar revisión solo con archivos completos ya disponibles y reescanear antes de cerrar",
      "Partes modificadas/accesorios visibles pueden respaldar captura comercial y textos; no inferir especificaciones no demostradas",
      "Material no seleccionado se clasifica para posible depuración, pero nunca se borra automáticamente; mostrar opciones antes de eliminar"
    ],
    "firstResponsePolicy": {
      "provideFolderAtStart": true,
      "authorizedPath": "AFL_AUTOS_MULTIMEDIA/01_ENTRADAS/00_PENDIENTE_ID",
      "resolveUrlAtRuntimeFromGoogleDrive": true,
      "publicRepositoryStoresPrivateUrl": false,
      "instruction": "Al iniciar un vehículo nuevo, proporcionar primero al usuario el enlace autorizado de esta carpeta para la carga inicial. Después continuar con identificación."
    },
    "partialUploadPolicy": {
      "allowed": true,
      "inspectOnlyAvailableCompleteFiles": true,
      "rescanBeforeClosingReview": true
    },
    "cleanupPolicy": {
      "autoDelete": false,
      "requireClassification": true,
      "showOptionsBeforeDelete": true
    }
  },
  "outputStatusModel": {
    "allowed": [
      "PENDIENTE",
      "EN_PRODUCCION",
      "LISTO",
      "PUBLICADO"
    ],
    "default": "PENDIENTE",
    "rules": {
      "pending": "Sin pieza final aprobada",
      "inProduction": "Edición/producción activa",
      "ready": "Pieza final aprobada y disponible",
      "published": "Publicación confirmada"
    }
  },
  "outputChannels": [
    {
      "key": "contentAvailable",
      "label": "Contenido disponible",
      "folder": "00_CONTENIDO_DISPONIBLE"
    },
    {
      "key": "marketplace",
      "label": "Marketplace",
      "folder": "10_MARKETPLACE"
    },
    {
      "key": "images",
      "label": "Imágenes comerciales",
      "folder": "20_IMAGENES_COMERCIALES"
    },
    {
      "key": "post",
      "label": "Post",
      "folder": "30_POST"
    },
    {
      "key": "feed",
      "label": "Feed",
      "folder": "40_FEED"
    },
    {
      "key": "stories",
      "label": "Historias",
      "folder": "50_HISTORIAS"
    },
    {
      "key": "covers",
      "label": "Portadas",
      "folder": "60_PORTADAS"
    },
    {
      "key": "reel",
      "label": "Reel",
      "folder": "70_REEL"
    },
    {
      "key": "tiktok",
      "label": "TikTok",
      "folder": "80_TIKTOK"
    },
    {
      "key": "whatsapp",
      "label": "WhatsApp oculto",
      "folder": "90_WHATSAPP_OCULTO"
    },
    {
      "key": "sendPackage",
      "label": "Para enviar",
      "folder": "95_PARA_ENVIAR"
    }
  ]
}
