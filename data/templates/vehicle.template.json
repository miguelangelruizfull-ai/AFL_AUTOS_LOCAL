    "resumeFrom": "Leer evidencia mínima del vehículo y ejecutar únicamente el siguiente paso válido.",
    "driveControlDocument": null
  },
  "promptProtocol": {
    "purpose": "Continuar una unidad desde el checkpoint persistido y permitir cambios autorizados sin depender de memoria del chat.",
    "minimalSources": [
      "data/vehicles/AFL-ID.json",
      "data/vehicles/index.json",
      "Drive: 01_ENTRADAS/AFL-ID",
      "Drive: 02_SALIDAS/AFL-ID",
      "Drive: documento AFL-ID — CONTROL OPERATIVO"
    ],
    "afterEveryPrompt": [
      "Actualizar Drive y CONTROL OPERATIVO cuando el prompt produzca un cambio.",
      "Actualizar data/vehicles/AFL-ID.json.",
      "Actualizar data/vehicles/index.json para HOME.",
      "Actualizar documentación operativa relevante.",
      "Verificar consistencia Drive ↔ vehículo JSON ↔ HOME.",
      "Persistir checkpoint.nextAction cuando cambie el flujo.",
      "Después de PROGRAMAR, PUBLICAR o ejecutar una acción de cambio autorizada, actualizar siempre data/vehicles/index.json para que HOME refleje el cambio.",
      "Cuando exista fecha/hora programada, sincronizar también data/programador.json con la fuente real de programación.",
      "Si el ChatGPT actual recomienda una siguiente acción útil, mostrarla y después regresar al menú/opciones del vehículo; si no existe recomendación concreta, omitir ese bloque.",
      "Al PROGRAMAR o PUBLICAR una pieza, actualizar el archivo real correspondiente dentro de 02_SALIDAS/AFL-ID/<CANAL> con copy final, estado, fecha/hora e identificador disponible.",
      "Al cerrar cualquier operación del vehículo, mostrar SIEMPRE al final una sección de opciones.",
      "La primera opción debe ser la SIGUIENTE ACCIÓN RECOMENDADA por el ChatGPT actual cuando exista una recomendación concreta.",
      "Después mostrar las demás opciones operativas relevantes del vehículo.",
      "Si no existe una recomendación concreta, mostrar las demás opciones sin inventar una recomendación.",
      "Las opciones deben incluir enlaces operativos cuando existan.",
      "El cierre no se considera completo si el estado cambió y las opciones finales no reflejan el nuevo checkpoint."
    ],
    "rules": [
      "No mezclar vehículos.",
      "No publicar automáticamente.",
      "No exponer VIN completo, odómetro, documentos privados o PII.",
      "La recomendación operativa corresponde al ChatGPT actual.",
      "Los cambios autorizados por Miguel se limitan al campo y valor indicados.",
      "PROGRAMADA no equivale a PUBLICADO; MEDICION_7D inicia desde PUBLICADO_CONFIRMADO_POR_MIGUEL."
    ],
    "responseLinks": [],
    "closureMenuPolicy": {
      "alwaysShowOptionsAtEnd": true,
      "recommendedFirst": true,
      "recommendationAuthority": "CHATGPT_CURRENT",
      "showOtherRelevantOptions": true,
      "omitRecommendedWhenNone": true,
      "includeOperationalLinks": true,
      "mustReflectLatestCheckpoint": true
    }
  },
  "promptMenu": [
    {
      "key": "resume",
      "label": "Reanudar desde aquí",
      "description": "Continuar desde el checkpoint vigente.",
      "instruction": "Detecta el patrón desde checkpoint y evidencia; ejecuta únicamente el siguiente paso válido."
    },
    {
      "key": "editAuthorized",
      "label": "Editar información autorizada por Miguel",
      "description": "Modificar cualquier campo autorizado y sincronizar Drive + JSON + HOME.",
      "instruction": "Ejecuta data/prompts/editar-informacion-autorizada.json con el CAMPO y NUEVO_VALOR indicados por Miguel."
    },
    {
      "key": "captureUploaded",
      "label": "Ya subí nueva captura",
      "description": "Procesar material de 20_NUEVA_CAPTURA.",
      "instruction": "Confirma evidencia nueva antes de registrar MATERIAL_NUEVO_SUBIDO y ejecutar REVISION_MATERIAL."
    },
    {
      "key": "finalSelection",
      "label": "Revisar y seleccionar material",
      "description": "Revisar faltantes y seleccionar material por canal.",
      "instruction": "Ejecuta REVISION_MATERIAL/SELECCION_FINAL según evidencia y conserva CAPTURA_PENDIENTE si faltan tomas obligatorias."
    },
    {
      "key": "finishOutputs",
      "label": "Terminar piezas",
      "description": "Generar o actualizar salidas con material suficiente.",
      "instruction": "Actualiza únicamente piezas respaldadas por selección final; WhatsApp permanece OCULTO hasta validación."
    },
    {
      "key": "syncAudit",
      "label": "Auditar sincronización",
      "description": "Comprobar Drive, JSON y HOME.",
      "instruction": "Corrige contradicciones verificables sin publicar."
    },
    {
      "key": "publicationStatus",
      "label": "Confirmar publicación / medición 7D",
      "description": "Confirmar publicación real y preparar medición semanal.",
      "instruction": "Cuando exista confirmación real, sincroniza publicación y HOME y activa MEDICION_7D; no crear 24H/72H rutinarios."
    }
  ],
